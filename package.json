      },
      {
        "command": "gaffy.sel.through",
        "title": "Select Callers and Callees (through)"
      },
      {
        "command": "gaffy.sel.between",
        "title": "Select Paths Between the 2 Selected"
      },
      {
        "command": "gaffy.sel.hide",
        "title": "Hide Selection"
      },
      {
        "command": "gaffy.sel.isolate",
        "title": "Show Only Selection"
      },
      {
        "command": "gaffy.sel.clear",
        "title": "Clear Selection"
      },
      {
        "command": "gaffy.node.hide",
        "title": "Hide"
      },
      {
        "command": "gaffy.node.showHidden",
        "title": "Show Hidden Neighbors…"
      },
      {
        "command": "gaffy.node.collapseClass",
        "title": "Collapse Class"
      },
      {
        "command": "gaffy.node.collapseFile",
        "title": "Collapse Module / File"
      },
      {
        "command": "gaffy.node.collapsePackage",
        "title": "Collapse Package / Folder"
      },
      {
        "command": "gaffy.node.expandContainer",
        "title": "Expand Container"
      },
      {
        "command": "gaffy.node.lock",
        "title": "Lock Position"
      },
      {
        "command": "gaffy.node.unlock",
        "title": "Unlock Position"
      },
      {
        "command": "gaffy.node.moveUp",
        "title": "Move Up Among Siblings"
      },
      {
        "command": "gaffy.node.moveDown",
        "title": "Move Down Among Siblings"
      },
      {
        "command": "gaffy.node.tag",
        "title": "Tag…"
      },
      {
        "command": "gaffy.node.revealInExplorer",
        "title": "Reveal in Explorer"
      },
      {
        "command": "gaffy.node.copyPath",
        "title": "Copy path:line"
      },
      {
        "command": "gaffy.node.copyQualname",
        "title": "Copy Qualified Name"
      },
      {
        "command": "gaffy.edge.subtree",
        "title": "Isolate This Call (caller and what lies below)"
      },
      {
        "command": "gaffy.edge.path",
        "title": "Isolate the Path Through This Call"
      },
      {
        "command": "gaffy.edge.callSite",
        "title": "Go to Call Site"
      },
      {
        "command": "gaffy.edge.callee",
        "title": "Go to Callee"
      },
      {
        "command": "gaffy.resetLayout",
        "title": "Reset Layout (moves, locks, sibling order)",
        "category": "gaffy"
      },
      {
        "command": "gaffy.showAll",
        "title": "Show All (unhide, unfold, expand)",
        "category": "gaffy"
      },
      {
        "command": "gaffy.clearCache",
        "title": "Clear Call Cache",
        "category": "gaffy"
      },
      {
        "command": "gaffy.node.groupModule",
        "title": "Group Its Module"
      },
      {
        "command": "gaffy.node.ungroup",
        "title": "Ungroup (dissolve this box)"
      },
      {
        "command": "gaffy.node.groupInside",
        "title": "Group Modules Inside"
      },
      {
        "command": "gaffy.resetView",
        "title": "Reset View (seeds, direction, depth)",
        "category": "gaffy"
      },
      {
        "command": "gaffy.isolateSelection",
        "title": "Isolate Selection",
        "category": "gaffy"
      },
      {
        "command": "gaffy.node.openCallers",
        "title": "Open Callers (one layer)"
      },
      {
        "command": "gaffy.node.openCalls",
        "title": "Open Calls (one layer)"
      },
      {
        "command": "gaffy.node.closeCallers",
        "title": "Close Callers"
      },
      {
        "command": "gaffy.node.closeCalls",
        "title": "Close Calls"
      },
      {
        "command": "gaffy.edge.straighten",
        "title": "Straighten This Call (route it first)"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "gaffy.graphCallers",
          "when": "editorHasCallHierarchyProvider || resourceExtname =~ /^\\.(glsl|vert|frag|geom|comp|tesc|tese|rgen|rint|rahit|rchit|rmiss|rcall|mesh|task|hlsl|hlsli|fx|fxh|slang|slangh|wgsl|metal)$/",
          "group": "navigation@90"
        },
        {
          "command": "gaffy.graphCallees",
          "when": "editorHasCallHierarchyProvider || resourceExtname =~ /^\\.(glsl|vert|frag|geom|comp|tesc|tese|rgen|rint|rahit|rchit|rmiss|rcall|mesh|task|hlsl|hlsli|fx|fxh|slang|slangh|wgsl|metal)$/",
          "group": "navigation@91"
        },
        {
          "command": "gaffy.addToView",
          "when": "editorHasCallHierarchyProvider || resourceExtname =~ /^\\.(glsl|vert|frag|geom|comp|tesc|tese|rgen|rint|rahit|rchit|rmiss|rcall|mesh|task|hlsl|hlsli|fx|fxh|slang|slangh|wgsl|metal)$/",
          "group": "navigation@92"
        }
      ],
      "gaffy.editor": [
        {
          "command": "gaffy.graphCallers",
          "group": "1@1"
        },
        {
          "command": "gaffy.graphCallees",
          "group": "1@2"
        },
        {
          "command": "gaffy.graphBoth",
          "group": "1@3"
        },
        {
          "command": "gaffy.addToView",
          "group": "2@1"
        }
      ],
      "explorer/context": [
        {
          "submenu": "gaffy.explorer",
          "when": "!explorerResourceIsFolder",
          "group": "z_gaffy@1"
        }
      ],
      "gaffy.explorer": [
        {
          "command": "gaffy.graphFile",
          "group": "1@1"
        }
      ],
      "webview/context": [
        {
          "command": "gaffy.node.open",
          "when": "webviewId == 'gaffy.view' && webviewSection =~ /^(node|collapsed)$/",
          "group": "1_nav@1"
        },
        {
          "command": "gaffy.node.editorMenu",
          "when": "webviewId == 'gaffy.view' && webviewSection =~ /^(node)$/",
          "group": "1_nav@2"
        },
        {
          "command": "gaffy.node.references",
