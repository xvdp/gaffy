  "scripts": {
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:matrix": "GAFFY_MATRIX=1 vitest run test/matrix.test.ts",
    "package": "npm run typecheck && npm test && npm run build && vsce package --no-dependencies",
    "release": "npm run typecheck && npm test && npm version patch --no-git-tag-version && npm run build && vsce package --no-dependencies",
    "install:local": "code --install-extension gaffy-$npm_package_version.vsix",
    "docs:check": "npm run heuristics && git diff --exit-code -- docs src/core/rules.lines.ts schemas/style.schema.json",
    "preview": "npm run build && node scripts/preview.mjs",
    "heuristics": "node scripts/heuristics.mjs",
    "explain": "node scripts/explain.mjs",
    "providers": "node scripts/providers.mjs",
    "metrics": "node scripts/metrics.mjs"
  },
