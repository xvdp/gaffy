        },
        {
          "command": "gaffy.node.why",
          "when": "webviewId == 'gaffy.view' && webviewSection =~ /^(node|collapsed|box)$/ && config.gaffy.debugLayout",
          "group": "6_place@9"
        },
        {
          "command": "gaffy.node.moveUp",
          "when": "webviewId == 'gaffy.view' && webviewSection =~ /^(node|collapsed)$/",
          "group": "6_place@3"
        },
