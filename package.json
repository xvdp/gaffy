    "@types/vscode": "1.90.0",
    "@vscode/vsce": "4.1.1",
    "esbuild": "0.28.2",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  },
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "In a workspace that is not trusted, gaffy does not run git (view file names take the date instead of the commit), records no trace, and reads gaffy.trace, gaffy.exclude and gaffy.style from user settings only. Language servers follow their own trust rules.",
      "restrictedConfigurations": [
        "gaffy.trace",
        "gaffy.exclude",
        "gaffy.style"
      ]
    },
    "virtualWorkspaces": false
  }
