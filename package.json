        "category": "gaffy"
      },
      {
        "command": "gaffy.rearrange",
        "title": "Re-arrange",
        "category": "gaffy"
      },
      {
        "command": "gaffy.unlockAll",
        "title": "Unlock all",
        "category": "gaffy"
      },
      {
        "command": "gaffy.expandAll",
        "title": "Expand collapsed",
        "category": "gaffy"
      },
      {
        "command": "gaffy.unhideAll",
        "title": "Unhide All",
        "category": "gaffy"
      },
      {
        "command": "gaffy.node.open",
        "title": "Go to Definition"
      },
      {
        "command": "gaffy.node.editorMenu",
