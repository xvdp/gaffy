{
  "name": "gaffy",
  "displayName": "gaffy",
  "description": "Persistent, manipulable call graphs on a character grid, rendered with D3",
  "version": "0.8.0",
  "publisher": "xvdp",
  "license": "UNLICENSED",
  "private": true,
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Visualization",
    "Programming Languages"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "workspaceContains:.gaffy"
  ],
  "contributes": {
    "customEditors": [
      {
        "viewType": "gaffy.view",
        "displayName": "gaffy graph",
        "selector": [
          {
            "filenamePattern": "*.gaffy"
          }
        ],
        "priority": "default"
      }
    ],
    "jsonValidation": [
      {
        "fileMatch": "**/.gaffy/style.json",
        "url": "./schemas/style.schema.json"
      }
    ],
    "configuration": {
      "title": "gaffy",
      "properties": {
        "gaffy.depth": {
          "type": "integer",
          "default": 3,
          "minimum": 1,
          "description": "Stable views: layers prefetched in the background along the traversal direction (the screen shows one layer per open side). Automatic views: hop limit."
        },
        "gaffy.maxNodes": {
          "type": "integer",
          "default": 400,
          "minimum": 10,
          "description": "Upper bound on definitions fetched per view build."
        },
        "gaffy.includeExternal": {
          "type": "boolean",
          "default": false,
          "description": "Include definitions outside the workspace (site-packages, node_modules, library stubs)."
        },
        "gaffy.autoSave": {
          "type": "boolean",
          "default": true,
          "description": "Save the .gaffy view file after every change made in the graph."
        },
        "gaffy.refreshOnSave": {
          "type": "string",
          "enum": [
            "touched",
            "all",
            "off"
          ],
          "default": "touched",
          "description": "Update open views after a source file is saved: views containing the file, all open views, or none. Stable views ask again only the calls the save made stale."
        },
        "gaffy.openBeside": {
          "type": "boolean",
          "default": true,
          "description": "Open definitions in the column beside the graph."
        },
        "gaffy.style": {
          "type": "object",
          "default": {},
          "description": "Style overrides; .gaffy/style.json overrides these."
        },
        "gaffy.exclude": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "**/tests/**",
            "**/test/**",
            "**/__tests__/**",
            "**/test_*.py",
            "**/*_test.*",
            "**/*_unittest.*",
            "**/*.test.*",
            "**/*.spec.*"
          ],
          "description": "Workspace-relative globs left out of view builds; a view can include a folder again from its toolbar."
        },
        "gaffy.openCallHierarchy": {
          "type": "boolean",
          "default": true,
          "description": "Also open the VS Code Call Hierarchy (References view) when a gaffy view is created from the editor."
        }
      }
    },
    "commands": [
      {
        "command": "gaffy.graphCallers",
        "title": "gaffy: Upstream callers"
      },
      {
        "command": "gaffy.graphCallees",
        "title": "gaffy: Calls downstream"
      },
      {
        "command": "gaffy.graphBoth",
        "title": "gaffy: Upstream callers and calls downstream"
      },
      {
        "command": "gaffy.addToView",
        "title": "gaffy: Add to view"
      },
      {
        "command": "gaffy.graphFile",
        "title": "New View: Functions of File",
        "category": "gaffy"
      },
      {
        "command": "gaffy.refresh",
        "title": "Refresh from Language Server",
        "category": "gaffy"
      },
      {
        "command": "gaffy.export",
        "title": "Export View as ASCII",
        "category": "gaffy"
      },
      {
        "command": "gaffy.editStyle",
        "title": "Edit Style",
        "category": "gaffy"
      },
      {
        "command": "gaffy.toggleBoxes",
        "title": "Toggle Group Namespaces",
        "category": "gaffy"
      },
      {
        "command": "gaffy.toggleEdges",
        "title": "Toggle Glyph or Vector Edges",
        "category": "gaffy"
      },
      {
        "command": "gaffy.rearrange",
        "title": "Re-arrange Unlocked Nodes and Boxes",
        "category": "gaffy"
      },
      {
        "command": "gaffy.unlockAll",
        "title": "Unlock All Positions",
        "category": "gaffy"
      },
      {
        "command": "gaffy.unhideAll",
        "title": "Unhide All",
        "category": "gaffy"
      },
      {
        "command": "gaffy.node.open",
        "title": "Go to Definition"
      },
      {
        "command": "gaffy.node.editorMenu",
