    "menus": {
      "editor/context": [
        {
          "command": "gaffy.graphCallers",
          "when": "editorHasCallHierarchyProvider || resourceExtname =~ /^\\.(glsl|vert|frag|geom|comp|tesc|tese|rgen|rint|rahit|rchit|rmiss|rcall|mesh|task|hlsl|hlsli|fx|fxh|slang|slangh|wgsl|metal)$/",
          "group": "0_navigation@5"
        },
        {
          "command": "gaffy.graphCallees",
          "when": "editorHasCallHierarchyProvider || resourceExtname =~ /^\\.(glsl|vert|frag|geom|comp|tesc|tese|rgen|rint|rahit|rchit|rmiss|rcall|mesh|task|hlsl|hlsli|fx|fxh|slang|slangh|wgsl|metal)$/",
          "group": "0_navigation@6"
        },
        {
          "command": "gaffy.addToView",
          "when": "editorHasCallHierarchyProvider || resourceExtname =~ /^\\.(glsl|vert|frag|geom|comp|tesc|tese|rgen|rint|rahit|rchit|rmiss|rcall|mesh|task|hlsl|hlsli|fx|fxh|slang|slangh|wgsl|metal)$/",
          "group": "0_navigation@7"
        }
      ],
      "gaffy.editor": [
        {
          "command": "gaffy.graphCallers",
          "group": "1@1"
        },
        {
          "command": "gaffy.graphCallees",
          "group": "1@2"
        },
        {
          "command": "gaffy.addToView",
          "group": "2@1"
        }
      ],
      "explorer/context": [
        {
          "submenu": "gaffy.explorer",
          "when": "!explorerResourceIsFolder",
          "group": "z_gaffy@1"
        }
      ],
      "gaffy.explorer": [
        {
          "command": "gaffy.graphFile",
          "group": "1@1"
        }
      ],
      "webview/context": [
        {
          "command": "gaffy.view.save",
          "when": "webviewId == 'gaffy.view' && webviewSection == 'canvas' && !config.gaffy.autoSave",
          "group": "1_file@1"
        },
        {
          "command": "gaffy.toggleAutoSave",
          "when": "webviewId == 'gaffy.view' && webviewSection == 'canvas' && !config.gaffy.autoSave",
          "group": "1_file@2"
        },
        {
          "command": "gaffy.toggleAutoSave.checked",
          "when": "webviewId == 'gaffy.view' && webviewSection == 'canvas' && config.gaffy.autoSave",
          "group": "1_file@2"
        },
        {
          "command": "gaffy.export",
          "when": "webviewId == 'gaffy.view' && webviewSection == 'canvas'",
          "group": "1_file@3"
        },
        {
          "command": "gaffy.refresh",
          "when": "webviewId == 'gaffy.view' && webviewSection == 'canvas'",
          "group": "1_file@4"
        },
        {
          "command": "gaffy.isolateSelection",
          "when": "webviewId == 'gaffy.view' && webviewSection == 'canvas'",
          "group": "2_selection@1"
        },
        {
          "command": "gaffy.sel.clear",
          "when": "webviewId == 'gaffy.view' && webviewSection == 'canvas'",
          "group": "2_selection@2"
        },
        {
          "command": "gaffy.toggleBoxes",
          "when": "webviewId == 'gaffy.view' && webviewSection == 'canvas' && !boxes",
          "group": "3_arrange@1"
        },
        {
          "command": "gaffy.toggleBoxes.checked",
          "when": "webviewId == 'gaffy.view' && webviewSection == 'canvas' && boxes",
          "group": "3_arrange@1"
        },
        {
          "command": "gaffy.tightBoxes",
          "when": "webviewId == 'gaffy.view' && webviewSection == 'canvas' && !tight",
          "group": "3_arrange@2"
        },
        {
          "command": "gaffy.tightBoxes.checked",
          "when": "webviewId == 'gaffy.view' && webviewSection == 'canvas' && tight",
          "group": "3_arrange@2"
        },
        {
          "command": "gaffy.resetView",
          "when": "webviewId == 'gaffy.view' && webviewSection == 'canvas'",
          "group": "3_arrange@3"
        },
        {
          "command": "gaffy.resetLayout",
          "when": "webviewId == 'gaffy.view' && webviewSection == 'canvas'",
          "group": "3_arrange@4"
        },
        {
          "command": "gaffy.rearrange",
          "when": "webviewId == 'gaffy.view' && webviewSection == 'canvas' && !selected",
          "group": "3_arrange@5"
        },
        {
          "command": "gaffy.sel.rearrange",
          "when": "webviewId == 'gaffy.view' && webviewSection == 'canvas' && selected",
          "group": "3_arrange@5"
        },
        {
          "command": "gaffy.unlockAll",
          "when": "webviewId == 'gaffy.view' && webviewSection == 'canvas'",
          "group": "3_arrange@6"
        },
        {
          "command": "gaffy.expandAll",
          "when": "webviewId == 'gaffy.view' && webviewSection == 'canvas'",
          "group": "3_arrange@7"
        },
        {
          "command": "gaffy.node.open",
          "when": "webviewId == 'gaffy.view' && webviewSection =~ /^(node|collapsed)$/ && !config.gaffy.openDefinitions",
          "group": "1_nav@1"
        },
        {
          "command": "gaffy.node.editorMenu",
          "when": "webviewId == 'gaffy.view' && webviewSection =~ /^(node)$/",
          "group": "1_nav@2"
        },
        {
          "command": "gaffy.node.references",
          "when": "webviewId == 'gaffy.view' && webviewSection =~ /^(node)$/",
          "group": "1_nav@3"
        },
        {
          "command": "gaffy.node.callHierarchy",
          "when": "webviewId == 'gaffy.view' && webviewSection =~ /^(node)$/",
          "group": "1_nav@4"
        },
        {
          "command": "gaffy.node.revealInExplorer",
          "when": "webviewId == 'gaffy.view' && webviewSection =~ /^(node|collapsed|box)$/",
          "group": "1_nav@5"
        },
        {
          "command": "gaffy.node.copyPath",
          "when": "webviewId == 'gaffy.view' && webviewSection =~ /^(node|collapsed|box)$/",
          "group": "1_nav@6"
        },
        {
          "command": "gaffy.node.copyQualname",
          "when": "webviewId == 'gaffy.view' && webviewSection =~ /^(node|collapsed|box)$/",
          "group": "1_nav@7"
        },
        {
          "command": "gaffy.node.openCallers",
          "when": "webviewId == 'gaffy.view' && webviewSection =~ /^(node|collapsed)$/ && oneLayer",
          "group": "2_graph@1"
        },
        {
          "command": "gaffy.node.openCalls",
          "when": "webviewId == 'gaffy.view' && webviewSection =~ /^(node|collapsed)$/ && oneLayer",
          "group": "2_graph@2"
        },
        {
          "command": "gaffy.node.closeCallers",
          "when": "webviewId == 'gaffy.view' && webviewSection =~ /^(node|collapsed)$/ && oneLayer",
          "group": "2_graph@3"
        },
        {
          "command": "gaffy.node.closeCalls",
          "when": "webviewId == 'gaffy.view' && webviewSection =~ /^(node|collapsed)$/ && oneLayer",
          "group": "2_graph@4"
        },
        {
          "command": "gaffy.node.makeSeed",
          "when": "webviewId == 'gaffy.view' && webviewSection =~ /^(node)$/",
          "group": "2_graph@5"
        },
        {
          "command": "gaffy.node.removeSeed",
          "when": "webviewId == 'gaffy.view' && webviewSection =~ /^(node)$/",
          "group": "2_graph@6"
        },
        {
          "command": "gaffy.sel.upstream",
          "when": "webviewId == 'gaffy.view' && webviewSection =~ /^(node|collapsed)$/",
          "group": "3_select@1"
        },
        {
          "command": "gaffy.sel.downstream",
          "when": "webviewId == 'gaffy.view' && webviewSection =~ /^(node|collapsed)$/",
          "group": "3_select@2"
        },
        {
          "command": "gaffy.sel.through",
          "when": "webviewId == 'gaffy.view' && webviewSection =~ /^(node|collapsed)$/",
          "group": "3_select@3"
        },
        {
          "command": "gaffy.sel.between",
          "when": "webviewId == 'gaffy.view' && webviewSection =~ /^(node|collapsed)$/",
          "group": "3_select@4"
        },
        {
          "command": "gaffy.sel.clear",
          "when": "webviewId == 'gaffy.view' && webviewSection =~ /^(node|collapsed)$/",
          "group": "3_select@5"
        },
        {
          "command": "gaffy.isolateSelection",
          "when": "webviewId == 'gaffy.view' && webviewSection =~ /^(node|collapsed)$/",
          "group": "4_show@1"
        },
        {
          "command": "gaffy.sel.hide",
          "when": "webviewId == 'gaffy.view' && webviewSection =~ /^(node|collapsed)$/",
          "group": "4_show@2"
        },
        {
          "command": "gaffy.node.showHidden",
          "when": "webviewId == 'gaffy.view' && webviewSection =~ /^(node|collapsed)$/",
          "group": "4_show@3"
        },
        {
          "command": "gaffy.node.collapseClass",
          "when": "webviewId == 'gaffy.view' && webviewSection =~ /^(node|collapsed)$/",
          "group": "5_collapse@1"
        },
        {
          "command": "gaffy.node.collapseFile",
          "when": "webviewId == 'gaffy.view' && webviewSection =~ /^(node|collapsed|box)$/",
          "group": "5_collapse@2"
        },
        {
          "command": "gaffy.node.collapsePackage",
          "when": "webviewId == 'gaffy.view' && webviewSection =~ /^(node|collapsed|box)$/",
          "group": "5_collapse@3"
        },
        {
          "command": "gaffy.node.expandContainer",
          "when": "webviewId == 'gaffy.view' && webviewSection =~ /^(collapsed)$/",
          "group": "5_collapse@4"
        },
        {
          "command": "gaffy.node.groupModule",
          "when": "webviewId == 'gaffy.view' && webviewSection =~ /^(node|collapsed)$/",
          "group": "5_collapse@5"
        },
        {
          "command": "gaffy.node.ungroup",
          "when": "webviewId == 'gaffy.view' && webviewSection =~ /^(box)$/",
          "group": "5_collapse@6"
        },
        {
          "command": "gaffy.node.groupInside",
          "when": "webviewId == 'gaffy.view' && webviewSection =~ /^(box)$/",
          "group": "5_collapse@7"
        },
        {
          "command": "gaffy.sel.rearrange",
          "when": "webviewId == 'gaffy.view' && webviewSection =~ /^(node|collapsed)$/",
          "group": "6_place@0"
        },
        {
          "command": "gaffy.node.lock",
          "when": "webviewId == 'gaffy.view' && webviewSection =~ /^(node|collapsed|box)$/",
          "group": "6_place@1"
        },
