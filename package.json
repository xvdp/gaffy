{
  "name": "gaffy",
  "displayName": "gaffy",
  "description": "Persistent, manipulable call graphs on a character grid, rendered with D3",
  "version": "0.9.35",
  "publisher": "xvdp",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/xvdp/gaffy"
  },
  "private": true,
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Visualization",
    "Programming Languages"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "workspaceContains:.baggy/gaffy",
    "workspaceContains:.gaffy",
    "onStartupFinished"
  ],
  "contributes": {
    "customEditors": [
      {
        "viewType": "gaffy.view",
        "displayName": "gaffy graph",
        "selector": [
          {
            "filenamePattern": "*.gaffy"
          }
        ],
        "priority": "default"
      }
    ],
    "jsonValidation": [
      {
        "fileMatch": "**/.baggy/gaffy/style.json",
        "url": "./schemas/style.schema.json"
      }
    ],
    "configuration": {
      "title": "gaffy",
      "properties": {
        "gaffy.depth": {
          "type": "integer",
          "default": 3,
          "minimum": 1,
          "description": "Stable views: layers prefetched in the background along the traversal direction (the screen shows one layer per open side). Automatic views: hop limit."
        },
        "gaffy.maxNodes": {
          "type": "integer",
          "default": 400,
          "minimum": 10,
          "description": "Upper bound on definitions fetched per view build."
        },
        "gaffy.includeExternal": {
          "type": "boolean",
          "default": false,
          "description": "Show external code (installed packages, system headers, build output, wasm-pack glue). Options > Settings in a view toggles it; turning it on asks the language server again."
        },
        "gaffy.includeStandardLibrary": {
          "type": "boolean",
          "default": false,
          "description": "With gaffy.includeExternal: also show each language's own builtins and standard library (Python builtins and standard library, Rust core, alloc and std, C++ standard headers, TypeScript lib.*.d.ts). Off: installed packages show, the standard library does not. Applies when a view is drawn, without the language server."
        },
        "gaffy.autoSave": {
          "type": "boolean",
          "default": false,
          "description": "Autosave Graphs: a new view is written to .baggy/gaffy/ at once and every view is saved after each change. Off: a new view opens unsaved (bound to its .baggy/gaffy/ path); right click > Save writes it, closing it without saving discards it, and edits wait for Save. A view file with \"save\": true (written by a script) saves after each change either way. The canvas menu, Options > File > Autosave Graphs and this setting change the same value; changes from a view go to the workspace settings."
        },
        "gaffy.refreshOnSave": {
          "type": "string",
          "enum": [
            "touched",
            "all",
            "off"
          ],
          "default": "touched",
          "description": "Update open views after a source file is saved: views containing the file, all open views, or none. Stable views ask again only the calls the save made stale."
        },
        "gaffy.openDefinitions": {
          "type": "boolean",
          "default": true,
          "description": "Open definitions: a view started from the editor opens beside it, so the definition stays in view, and a click on a function opens its definition in the column next to the graph. Off: views open in the active column and a click only selects."
        },
        "gaffy.style": {
          "type": "object",
          "default": {},
          "description": "Appearance: font, colors, labels, frame and edge drawing (keys of schemas/style.schema.json); .baggy/gaffy/style.json overrides these. Layout choices are made per view in Options, rule switches and parameters in Options > Arrange > Rules; style keys for them are ignored."
        },
        "gaffy.exclude": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Workspace-relative globs whose functions views leave off screen (for example \"**/tests/**\"); a view can include such a folder again from Options > Folders. Calls into them are still fetched and kept."
        },
        "gaffy.openCallHierarchy": {
          "type": "boolean",
          "default": false,
          "description": "Also open the VS Code Call Hierarchy (References view) when a gaffy view is created from the editor."
        },
        "gaffy.bridges": {
          "type": "boolean",
          "default": true,
          "description": "Calls across languages, found from binding declarations in the workspace: Python calling C++/CUDA through pybind11, nanobind or torch operators; Python calling Slang through slangpy or slangtorch; TypeScript/JavaScript calling Rust through wasm-bindgen."
        },
        "gaffy.debugLayout": {
          "type": "boolean",
          "default": false,
          "description": "Layout debugging: right click a function or box > Why Here? lists the placement and settle decisions that put it there (rule, values, outcome); decisions past a threshold are flagged on the graph; Options > Arrange opens the debugging panel: Rules (every layout rule: switch, alternative, parameters, saved with the graph; links to its explanation and code), Actions (running log of what moved where and the rules behind it), Edges (routing record per call: order, arrival, cost, crossings). Offline: npm run explain in the gaffy repository."
        },
        "gaffy.trace": {
          "type": "boolean",
          "default": false,
          "description": "Record every change of a view (the click, key or menu entry and its grid cell, the functions that acted, the view fields changed, the labels and boxes that moved; undo and redo included) to .baggy/gaffy/trace/<view>.jsonl. Read it with tools/gaffy-trace.mjs from the gaffy repository."
        }
      }
    },
    "commands": [
      {
        "command": "gaffy.graphCallers",
        "title": "gaffy> Call Hierarchy (up)"
      },
      {
        "command": "gaffy.graphCallees",
        "title": "gaffy> Call Hierarchy (dn)"
      },
      {
        "command": "gaffy.addToView",
        "title": "gaffy> Add to Call Graph"
      },
      {
        "command": "gaffy.graphFile",
        "title": "Call Hierarchies (all, up)",
        "category": "gaffy"
      },
      {
        "command": "gaffy.refresh",
